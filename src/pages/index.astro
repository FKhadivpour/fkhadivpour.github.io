---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.jpg';
import { site, links } from '../data/site';
import { stats } from '../data/stats';
import { experience } from '../data/experience';
import { work } from '../data/work';
import { skills } from '../data/skills';
import { education } from '../data/education';
import { research } from '../data/research';

const formatNumber = (n: number) => n.toLocaleString('en-US');

// Structured data for search engines. No phone number: that stays in the CV.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  jobTitle: 'Founding AI Engineer',
  description: site.description,
  worksFor: { '@type': 'Organization', name: 'SISA Energy', url: links.sisa },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Alberta' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Vancouver',
    addressRegion: 'BC',
    addressCountry: 'CA',
  },
  sameAs: [links.linkedin, links.github],
};
---

<Base title={`${site.name} · ${site.role}`}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />

  <section class="wrap hero">
    <p class="eyebrow" data-reveal>{site.role} · {site.location}</p>
    <h1 class="thesis" data-reveal>
      {
        site.headline.map((line) => {
          // Split the line so exactly one word carries the accent.
          const [before, after] = line.split(site.headlineAccent);
          return (
            <>
              <span class="line">
                {after === undefined ? (
                  line
                ) : (
                  <>
                    {before}
                    <span class="accent">{site.headlineAccent}</span>
                    {after}
                  </>
                )}
              </span>{' '}
            </>
          );
        })
      }
    </h1>
    <p class="lede" data-reveal>
      I'm Faraz, founding AI engineer at <a href={links.sisa} rel="noopener">SISA Energy</a>,
      where I designed, built and run SISA AI, the agentic service behind
      <a href={links.collectflow} rel="noopener">CollectFlow</a>. I have worked at research pace
      at <a href={links.amii} rel="noopener">Amii</a>, at enterprise scale at
      <a href={links.scotiabank} rel="noopener">Scotiabank</a> and at startup speed, across AI
      engineering, machine learning and full-stack software.
    </p>
    <p class="actions" data-reveal>
      <a href={links.mailto}>get in touch →</a>
      <a href={links.linkedin} rel="me noopener">linkedin →</a>
      <a href={links.github} rel="me noopener">github →</a>
      <a href={links.cv}>cv →</a>
    </p>
  </section>

  <section class="wrap section">
    <ul class="stats boxes four" aria-label="Key figures">
      {
        stats.map((stat) => (
          <li class="box stat" data-reveal>
            <span class="figure" data-count={stat.value} data-suffix={stat.suffix}>
              {formatNumber(stat.value) + stat.suffix}
            </span>
            <span class="caption">{stat.caption}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="about" class="wrap section">
    <h2 class="heading" data-reveal>About</h2>
    <div class="about-grid">
      <div class="prose">
        <p data-reveal>
          I work on the boundary between people and machines, making each
          <span class="accent">legible</span> to the other. A model produces an answer; a
          person has to decide whether to trust it. Everything I build is some version of
          that problem.
        </p>
        <p data-reveal>
          I have worked on it in three kinds of place. In research, at
          <a href={links.amii} rel="noopener">Amii</a>, where an idea has to survive peer
          review and a human study. In a regulated bank,
          <a href={links.scotiabank} rel="noopener">Scotiabank</a>, where a model has to
          survive governance. And in a startup,
          <a href={links.sisa} rel="noopener">SISA Energy</a>, where it has to survive
          production.
        </p>
        <p data-reveal>
          Today I am the founding AI engineer at SISA Energy. I designed, built and run SISA
          AI, the agentic service behind
          <a href={links.collectflow} rel="noopener">CollectFlow</a>, and I work across the
          whole stack to ship it: the agent and its harness, the Python services, the React
          front end, the evaluation and the monitoring. I am also CollectFlow's product
          owner, so the work starts with a conversation with a client and ends when the
          feature is holding up in production.
        </p>
        <p data-reveal>
          None of that is glamorous. It's the difference between a model that works in a
          notebook and one someone trusts at three in the morning.
        </p>
      </div>
      <div class="portrait" data-reveal>
        <Image src={portrait} alt="Faraz Khadivpour" widths={[320, 640]} sizes="320px" />
      </div>
    </div>
  </section>

  <section id="experience" class="wrap section">
    <h2 class="heading" data-reveal>Experience</h2>
    <div class="boxes">
      {
        experience.map((job) => (
          <article class="box job" data-reveal>
            <p class="kicker">{job.env}</p>
            <h3 class="title">
              {job.role} · <a href={job.href} rel="noopener">{job.company}</a>
              {job.note && <span class="note">({job.note})</span>}
            </h3>
            <p class="meta">
              {job.location} · {job.dates}
            </p>
            <ul class="points">
              {job.points.map((point) => (
                <li set:html={point} />
              ))}
            </ul>
            <ul class="chips" aria-label="Stack">
              {job.stack.map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section id="work" class="wrap section">
    <h2 class="heading" data-reveal>Selected work</h2>
    <div class="boxes">
      {
        work.map((item, i) => (
          <article class="box entry" data-reveal>
            <p class="kicker">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              {item.kicker}
            </p>
            <h3 class="title">{item.title}</h3>
            <p class="sub">{item.body}</p>
            {item.principles && (
              <dl class="principles">
                {item.principles.map((principle) => (
                  <div>
                    <dt>{principle.name}</dt>
                    <dd>{principle.detail}</dd>
                  </div>
                ))}
              </dl>
            )}
            <p class="result">
              <span class="result-label">{item.resultLabel}</span>
              {item.result}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="skills" class="wrap section">
    <h2 class="heading" data-reveal>Skills</h2>
    <div class="boxes two">
      {
        skills.map((group) => (
          <article class="box skill" data-reveal>
            <h3 class="title">{group.group}</h3>
            <ul class="chips">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section id="education" class="wrap section">
    <h2 class="heading" data-reveal>Education</h2>
    <div class="boxes three">
      {
        education.map((degree) => (
          <article class="box degree" data-reveal>
            <p class="kicker">{degree.years}</p>
            <h3 class="title">{degree.degree}</h3>
            <p class="school">{degree.school}</p>
            {degree.note && <p class="sub">{degree.note}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section id="research" class="wrap section">
    <h2 class="heading" data-reveal>Research</h2>
    <div class="prose intro">
      <p data-reveal>
        Most explainability asks which parts of an input a model looked at. Responsibility
        asks which training examples were responsible for the decision. What comes back is not
        a heatmap but a precedent: this is classified this way because of these forty images.
      </p>
      <p data-reveal>
        The method improved interpretability by 5% on image classification and 20% on text
        classification, and a 300-participant human evaluation study showed a 30% preference
        over baseline approaches.
      </p>
    </div>
    <div class="boxes three">
      {
        research.map((paper) => {
          const Tag = paper.href ? 'a' : 'article';
          return (
            <Tag
              class="box paper"
              data-reveal
              {...(paper.href ? { href: paper.href, rel: 'noopener' } : {})}
            >
              <span class="kicker">
                {paper.venue} · {paper.year}
              </span>
              <span class="title">
                {paper.title}
                {paper.note && <span class="note"> ({paper.note})</span>}
              </span>
              {paper.href && <span class="more">read the paper →</span>}
            </Tag>
          );
        })
      }
    </div>
  </section>

  <section id="contact" class="wrap section contact">
    <h2 class="heading" data-reveal>Contact</h2>
    <div class="box contact-box" data-reveal>
      <p class="contact-line">
        Always open to connecting with people working on AI systems. Email is the fastest way
        to reach me.
      </p>
      <p class="contact-email">
        <a href={links.mailto}>{site.email}</a>
      </p>
      <p class="actions">
        <a href={links.linkedin} rel="me noopener">linkedin →</a>
        <a href={links.github} rel="me noopener">github →</a>
        <a href={links.cv}>cv →</a>
      </p>
    </div>
  </section>
</Base>
